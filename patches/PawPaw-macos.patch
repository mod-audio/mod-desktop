diff --git a/bootstrap-common.sh b/bootstrap-common.sh
index dd88e52..ec77347 100755
--- a/bootstrap-common.sh
+++ b/bootstrap-common.sh
@@ -247,10 +247,14 @@ fi
 # ---------------------------------------------------------------------------------------------------------------------
 # pkgconfig
 
-export EXTRA_CFLAGS="-Wno-int-conversion"
+# Xcode 26 defaults to GNU C23, where `bool` is a keyword.  The bundled
+# historic GLib in pkg-config uses `bool` as a struct member, so retain the
+# GNU C17 dialect required by that dependency on current macOS runners.
+export EXTRA_CFLAGS="-std=gnu17 -Wno-int-conversion"
 
 download pkg-config "${PKG_CONFIG_VERSION}" "${PKG_CONFIG_URL}"
 build_host_autoconf pkg-config "${PKG_CONFIG_VERSION}" "--enable-indirect-deps --with-internal-glib --with-pc-path=${TARGET_PKG_CONFIG_PATH}"
+unset EXTRA_CFLAGS
 
 if [ -n "${TOOLCHAIN_PREFIX_}" ] && [ ! -e "${PAWPAW_PREFIX}/bin/${TOOLCHAIN_PREFIX_}pkg-config" ]; then
     ln -s pkg-config "${PAWPAW_PREFIX}/bin/${TOOLCHAIN_PREFIX_}pkg-config"
diff --git a/bootstrap-mod.sh b/bootstrap-mod.sh
index 3ad26cf..84b2dc8 100755
--- a/bootstrap-mod.sh
+++ b/bootstrap-mod.sh
@@ -265,10 +265,20 @@ fi
 
 export AGGDRAW_FREETYPE_ROOT="${PAWPAW_PREFIX}"
 export LDSHARED="${TARGET_CXX}"
+# distutils applies CFLAGS to aggdraw's C++ source; gnu17 is a C-only dialect.
+AGGDRAW_CFLAGS="${CFLAGS}"
+export CFLAGS="${CFLAGS//-std=gnu17/}"
 
 download aggdraw "${AGGDRAW_VERSION}" "https://files.pythonhosted.org/packages/ef/29/fddf555c68920bb0aff977425af786226db2a78379e706951ff32b4492ef"
+# Its single extension contains C++ sources, while this Python's saved CFLAGS
+# include the C-only gnu17 mode needed during the historic pkg-config build.
+if ! grep -q "get_config_vars" "${PAWPAW_BUILDDIR}/aggdraw-${AGGDRAW_VERSION}/setup.py"; then
+    patch_file aggdraw "${AGGDRAW_VERSION}" "setup.py" 's/from distutils.sysconfig import get_config_var/from distutils.sysconfig import get_config_var, get_config_vars; get_config_vars()["CFLAGS"] = get_config_var("CFLAGS").replace("-std=gnu17", "")/'
+fi
 build_python aggdraw "${AGGDRAW_VERSION}"
 
+export CFLAGS="${AGGDRAW_CFLAGS}"
+unset AGGDRAW_CFLAGS
 unset AGGDRAW_FREETYPE_ROOT
 unset LDSHARED
 
