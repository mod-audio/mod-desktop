diff --git a/setup/env.sh b/setup/env.sh
index 5d40fe7..0e6d84a 100644
--- a/setup/env.sh
+++ b/setup/env.sh
@@ -176,8 +176,18 @@ fi
 # anything that talks to db should have this
 BUILD_FLAGS+=" -DHAVE_MIXED_SIZE_ADDRESSING"
 
-TARGET_CFLAGS="${BUILD_FLAGS}"
-TARGET_CXXFLAGS="${BUILD_FLAGS} -fvisibility-inlines-hidden"
+# Apple Clang 21 defaults C++ to C++23. PawPaw's historic C++ dependencies
+# need a pre-C++17 dialect because they use the removed `register` keyword.
+# The historic GLib in the host pkg-config build needs GNU C17, which
+# bootstrap-common scopes to that C-only build instead of leaking into C++
+# plugin and Python-extension compilation.
+if [ "${MACOS}" -eq 1 ]; then
+    TARGET_CFLAGS="${BUILD_FLAGS}"
+    TARGET_CXXFLAGS="${BUILD_FLAGS} -std=gnu++14 -fvisibility-inlines-hidden"
+else
+    TARGET_CFLAGS="${BUILD_FLAGS}"
+    TARGET_CXXFLAGS="${BUILD_FLAGS} -fvisibility-inlines-hidden"
+fi
 
 ## link flags
 
diff --git a/setup/functions.sh b/setup/functions.sh
index e141946..bc9476c 100644
--- a/setup/functions.sh
+++ b/setup/functions.sh
@@ -27,8 +27,10 @@ function download() {
             local tmprepodir="${PAWPAW_TMPDIR}/${dlname}-${version}"
             rm -rf "${tmprepodir}"
             git clone --recursive "${dlbaseurl}" "${tmprepodir}"
-            # pinned commit may no longer be reachable from any branch; fetch the exact object first
-            git -C "${tmprepodir}" fetch origin "${version}" || true
+            # Some historic MOD pins are retained by GitHub but are no longer
+            # reachable from the repository's default refs. Fetch the requested
+            # object explicitly before checking it out.
+            git -C "${tmprepodir}" fetch origin "${version}"
             git -C "${tmprepodir}" checkout "${version}"
             git -C "${tmprepodir}" submodule update --recursive --init
             tar --exclude=".git" -czf "${dlfile}" -C "${PAWPAW_TMPDIR}" "${dlname}-${version}"
@@ -101,8 +103,9 @@ function git_clone() {
         local tmprepodir="${PAWPAW_TMPDIR}/${dlname}-${hash}"
         rm -rf "${tmprepodir}"
         git clone --recursive "${repourl}" "${tmprepodir}"
-        # pinned commit may no longer be reachable from any branch; fetch the exact object first
-        git -C "${tmprepodir}" fetch origin "${hash}" || true
+        # Fetch the pinned object explicitly: an ordinary clone only fetches
+        # advertised refs and can omit a still-retrievable historic commit.
+        git -C "${tmprepodir}" fetch origin "${hash}"
         git -C "${tmprepodir}" checkout "${hash}"
         git -C "${tmprepodir}" submodule update --recursive --init
         tar --exclude=".git" -czf "${dlfile}" -C "${PAWPAW_TMPDIR}" "${dlname}-${hash}"
@@ -505,6 +508,8 @@ function build_python() {
     export CFLAGS="$(echo ${CFLAGS} | sed -e 's/-ffast-math//')"
     export CFLAGS="$(echo ${CFLAGS} | sed -e 's/-fno-finite-math-only//')"
     export CFLAGS="$(echo ${CFLAGS} | sed -e 's/-fno-strict-aliasing -flto//')"
+    # Python extension build scripts may compile C++ sources with CFLAGS.
+    export CFLAGS="$(echo ${CFLAGS} | sed -e 's/-std=gnu17//')"
     export CXXFLAGS="$(echo ${CXXFLAGS} | sed -e 's/-fvisibility=hidden//')"
     export CXXFLAGS="$(echo ${CXXFLAGS} | sed -e 's/-fvisibility-inlines-hidden//')"
     export CXXFLAGS="$(echo ${CXXFLAGS} | sed -e 's/-fdata-sections -ffunction-sections//')"
