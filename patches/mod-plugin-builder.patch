diff --git a/plugins/package/fluidplug/fluidplug.mk b/plugins/package/fluidplug/fluidplug.mk
index e060940..2cbe52e 100644
--- a/plugins/package/fluidplug/fluidplug.mk
+++ b/plugins/package/fluidplug/fluidplug.mk
@@ -12,6 +12,12 @@ FLUIDPLUG_BUNDLES = Black_Pearl_4A.lv2 Black_Pearl_4B.lv2 Black_Pearl_5.lv2 Flui
 
 FLUIDPLUG_TARGET_MAKE = $(TARGET_MAKE_ENV) $(TARGET_CONFIGURE_OPTS) $(MAKE) NOOPT=true -C $(@D)
 
+define FLUIDPLUG_POST_PATCH_HOOK
+	# The macOS system wget cannot validate the current LinuxAudio certificate chain.
+	# curl uses the system trust store and preserves the upstream basename with -O.
+	sed -i -e 's|wget https://|curl -fLO https://|g' $(@D)/Makefile
+endef
+
 define FLUIDPLUG_BUILD_CMDS
 	$(FLUIDPLUG_TARGET_MAKE)
 endef
