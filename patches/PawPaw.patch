@@ -0,0 +1,55 @@
+diff -ru a/common/JackClient.cpp b/common/JackClient.cpp
+--- a/common/JackClient.cpp	2026-10-31 11:54:56.908178525 +0100
++++ b/common/JackClient.cpp	2026-10-31 11:54:56.916178790 +0100
+@@ -28,6 +28,7 @@
+ #include "JackTransportEngine.h"
+ #include "driver_interface.h"
