++#include "JackTools.h"
+ 
+ #include <math.h>
+ #include <string>
+@@ -546,13 +547,25 @@
+ 
+ void JackClient::SetupRealTime()
+ {
++    UInt64 period = GetEngineControl()->fPeriod;
++    UInt64 computation = GetEngineControl()->fComputation;
++    UInt64 constraint = GetEngineControl()->fConstraint;
++
++    // The macOS CoreAudio driver only fills these in on its first cycle. An internal client loaded before the
++    // server starts would ask for a time-constraint policy of zeros, which macOS refuses, leaving the client
++    // thread non real-time. Use the same buffer-size based values as JackThreadedDriver::SetRealTime instead.
++    if (period == 0 || computation == 0 || constraint == 0) {
++        period = constraint = UInt64(GetEngineControl()->fPeriodUsecs) * 1000;
++        computation = UInt64(JackTools::ComputationMicroSec(GetEngineControl()->fBufferSize)) * 1000;
++    }
++
+     jack_log("JackClient::Init : period = %ld computation = %ld constraint = %ld",
+-             long(int64_t(GetEngineControl()->fPeriod) / 1000.0f),
+-             long(int64_t(GetEngineControl()->fComputation) / 1000.0f),
+-             long(int64_t(GetEngineControl()->fConstraint) / 1000.0f));
++             long(int64_t(period) / 1000.0f),
++             long(int64_t(computation) / 1000.0f),
++             long(int64_t(constraint) / 1000.0f));
+ 
+     // Will do "something" on OSX only...
+-    fThread.SetParams(GetEngineControl()->fPeriod, GetEngineControl()->fComputation, GetEngineControl()->fConstraint);
++    fThread.SetParams(period, computation, constraint);
+ 
+     if (fThread.AcquireSelfRealTime(GetEngineControl()->fClientPriority) < 0) {
+         jack_error("JackClient::AcquireSelfRealTime error");
+diff -ru a/macosx/JackMachThread.mm b/macosx/JackMachThread.mm
